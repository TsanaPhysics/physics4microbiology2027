% ====================================================================
% 1. PAGE GEOMETRY (A4 Standard Academic Monograph — RBRU 1.5in Margin)
% ====================================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=1.5in,
    bottom=1.0in,
