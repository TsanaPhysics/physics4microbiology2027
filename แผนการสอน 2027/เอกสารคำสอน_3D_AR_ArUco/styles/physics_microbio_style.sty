% ====================================================================
% 10. 3D WEBAR ARUCO MARKER VECTOR ENGINE (DICT_4X4_50 IDs 0-11)
% ====================================================================
\definecolor{arCyan}{HTML}{00B4D8}
\definecolor{arDark}{HTML}{0F172A}

\newcommand{\drawaruco}[2][2.4cm]{%
  \begin{tikzpicture}[x=\dimexpr#1/6\relax, y=\dimexpr#1/6\relax]
    % Quiet zone white border
    \fill[white, draw=physRoyalBlue!60, line width=0.6pt] (-0.35,-0.35) rectangle (6.35,6.35);
    % 6x6 Black base (includes 1-bit outer black border)
    \fill[black] (0,0) rectangle (6,6);
    % Top-left orientation corner triangle
    \fill[bioEmerald] (-0.35,6.35) -- (0.45,6.35) -- (-0.35,5.55) -- cycle;
    \ifnum#2=0\relax
      \foreach \x/\y in {1/4, 3/4, 4/4, 2/3, 4/3, 3/2, 4/2, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=1\relax
      \foreach \x/\y in {1/3, 2/3, 3/3, 4/3, 1/2, 4/2, 1/1, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=2\relax
      \foreach \x/\y in {3/4, 4/4, 3/3, 4/3, 2/2, 1/1, 2/1, 4/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=3\relax
      \foreach \x/\y in {1/4, 4/4, 1/3, 4/3, 2/2, 2/1, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=4\relax
      \foreach \x/\y in {2/4, 4/4, 2/3, 3/3, 1/2, 4/2, 1/1, 2/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=5\relax
      \foreach \x/\y in {1/4, 2/4, 4/4, 2/2, 3/2, 4/2, 2/1, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=6\relax
      \foreach \x/\y in {2/4, 3/4, 4/4, 1/3, 3/3, 4/3, 3/1, 4/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=7\relax
      \foreach \x/\y in {3/4, 1/3, 1/2, 2/2, 3/2, 2/1, 4/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=8\relax
      \foreach \x/\y in {1/4, 2/4, 3/4, 1/3, 2/3, 3/2, 1/1, 4/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=9\relax
      \foreach \x/\y in {2/4, 1/3, 2/3, 3/3, 1/2, 3/2, 4/2, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=10\relax
      \foreach \x/\y in {1/4, 3/4, 3/3, 1/2, 2/2, 4/2, 2/1, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
    \ifnum#2=11\relax
      \foreach \x/\y in {1/4, 2/4, 2/3, 4/3, 4/2, 1/1, 2/1, 3/1} { \fill[white] (\x,\y) rectangle ++(1,1); }
    \fi
  \end{tikzpicture}%
}

\newtcolorbox{arucobox}[1]{
